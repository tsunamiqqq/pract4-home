rule "Розумне керування температурою"
when
    Item CurrentTemperature received update or
    Item MotionDetector changed or
    Item OutdoorTemperature received update or
    Time cron "0 */10 * * * ?"
then
    if (CurrentTemperature.state == NULL || TargetTemperature.state == NULL) return;
    
    val currentTemp = (CurrentTemperature.state as Number).doubleValue
    val targetTemp = (TargetTemperature.state as Number).doubleValue
    val isPresent = (MotionDetector.state == ON)
    
    var desiredTemp = 21.0
    val hour = now.getHour()

    switch (hour) {
        case 6,7,8: desiredTemp = 22.0
        case 9,10,11,12,13,14,15,16,17: desiredTemp = 20.0
        case 18,19,20,21,22: desiredTemp = 22.5
        default: desiredTemp = 19.0
    }

    if (!isPresent) { desiredTemp = desiredTemp - 2.0 }

    // --- КОРЕКЦІЯ ЗА ПОГОДОЮ ---
    if (OutdoorTemperature.state != NULL && OutdoorTemperature.state != UNDEF) {
        val outdoorTemp = (OutdoorTemperature.state as Number).doubleValue
        
        if (outdoorTemp < 0.0) {
            desiredTemp = desiredTemp + 1.0 // Мороз: робимо тепліше
        } else if (outdoorTemp > 25.0) {
            desiredTemp = desiredTemp - 1.0 // Спека: робимо прохолодніше
        }
    }
    // ----------------------------

    if (Math::abs(targetTemp - desiredTemp) > 0.5) {
        logInfo("Climate", String::format("Зміна температури: %.1f°C -> %.1f°C", targetTemp, desiredTemp))
        TargetTemperature.sendCommand(desiredTemp)
    }

    val tempDiff = Math::abs(currentTemp - desiredTemp)
    val comfort = Math::max(0.0, 10.0 - tempDiff * 2)
    ComfortIndex.postUpdate(comfort)
end

rule "Сповіщення про аномальну температуру"
when
    Item CurrentTemperature received update
then
    if (CurrentTemperature.state == NULL) return;
    val temp = (CurrentTemperature.state as Number).doubleValue
    if (temp < 15.0) {
        logWarn("Climate", "Дуже низька температура: " + temp + "°C")
    } else if (temp > 30.0) {
        logWarn("Climate", "Дуже висока температура: " + temp + "°C")
    }
end